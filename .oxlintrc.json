{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["oxc", "typescript", "unicorn"],
  "categories": {
    "correctness": "off"
  },
  "options": {
    "typeAware": true
  },
  "rules": {
    "eslint/array-callback-return": [
      "error",
      {
        "checkForEach": true,
        "allowVoid": true
      }
    ],
    "eslint/constructor-super": "error",
    "eslint/default-case-last": "warn",
    "eslint/eqeqeq": [
      "error",
      "always",
      {
        "null": "ignore"
      }
    ],
    "eslint/for-direction": "error",
    "eslint/getter-return": "error",
    "eslint/no-array-constructor": "warn",
    "eslint/no-async-promise-executor": "error",
    "eslint/no-case-declarations": "error",
    "eslint/no-class-assign": "error",
    "eslint/no-compare-neg-zero": "error",
    "eslint/no-cond-assign": ["error", "always"],
    "eslint/no-const-assign": "error",
    "eslint/no-constant-condition": "error",
    "eslint/no-constructor-return": "error",
    "eslint/no-control-regex": "error",
    "eslint/no-debugger": "error",
    "eslint/no-dupe-class-members": "error",
    "eslint/no-dupe-else-if": "error",
    "eslint/no-dupe-keys": "error",
    "eslint/no-duplicate-case": "error",
    "eslint/no-empty-character-class": "error",
    "eslint/no-empty-pattern": "error",
    "eslint/no-eval": "error",
    "eslint/no-ex-assign": "warn",
    "eslint/no-extra-boolean-cast": "warn",
    "eslint/no-extra-label": "warn",
    "eslint/no-fallthrough": "error",
    "eslint/no-func-assign": "error",
    "eslint/no-global-assign": "error",
    "eslint/no-import-assign": "error",
    "eslint/no-inner-declarations": [
      "error",
      "both",
      {
        "blockScopedFunctions": "allow"
      }
    ],
    "eslint/no-irregular-whitespace": "warn",
    "eslint/no-label-var": "error",
    "eslint/no-labels": [
      "warn",
      {
        "allowLoop": true
      }
    ],
    "eslint/no-lone-blocks": "warn",
    "eslint/no-loss-of-precision": "error",
    "eslint/no-misleading-character-class": "error",
    "eslint/no-new-native-nonconstructor": "error",
    "eslint/no-nonoctal-decimal-escape": "error",
    "eslint/no-obj-calls": "error",
    "eslint/no-proto": "warn",
    "eslint/no-prototype-builtins": "warn",
    "eslint/no-regex-spaces": "warn",
    "eslint/no-script-url": "error",
    "eslint/no-self-assign": "error",
    "eslint/no-self-compare": "error",
    "eslint/no-sequences": "warn",
    "eslint/no-setter-return": "error",
    "eslint/no-shadow-restricted-names": "error",
    "eslint/no-sparse-arrays": "error",
    "eslint/no-template-curly-in-string": "warn",
    "eslint/no-this-before-super": "error",
    "eslint/no-unneeded-ternary": "warn",
    "eslint/no-unreachable": "error",
    "eslint/no-unsafe-finally": "error",
    "eslint/no-unsafe-negation": "error",
    "eslint/no-unsafe-optional-chaining": "error",
    "eslint/no-unused-labels": "warn",
    "eslint/no-unused-private-class-members": "warn",
    "eslint/no-unused-vars": [
      "warn",
      {
        "args": "all",
        "varsIgnorePattern": "^_",
        "argsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_",
        "destructuredArrayIgnorePattern": "^_",
        "ignoreRestSiblings": true
      }
    ],
    "eslint/no-use-before-define": [
      "error",
      {
        "functions": false,
        "classes": false,
        "variables": false,
        "typedefs": false,
        "ignoreTypeReferences": true
      }
    ],
    "eslint/no-useless-backreference": "warn",
    "eslint/no-useless-catch": "warn",
    "eslint/no-useless-computed-key": "warn",
    "eslint/no-useless-constructor": "warn",
    "eslint/no-useless-escape": "warn",
    "eslint/no-useless-rename": "warn",
    "eslint/no-with": "error",
    "eslint/prefer-arrow-callback": "warn",
    "eslint/prefer-const": "warn",
    "eslint/prefer-exponentiation-operator": "warn",
    "eslint/prefer-numeric-literals": "warn",
    "eslint/prefer-object-has-own": "warn",
    "eslint/prefer-regex-literals": "warn",
    "eslint/prefer-rest-params": "warn",
    "eslint/prefer-template": "warn",
    "eslint/radix": "warn",
    "eslint/require-yield": "error",
    "eslint/use-isnan": "error",
    "eslint/valid-typeof": "error",
    "oxc/approx-constant": "warn",
    "oxc/bad-min-max-func": "error",
    "oxc/misrefactored-assign-op": "error",
    "oxc/no-accumulating-spread": "warn",
    "oxc/no-const-enum": "warn",
    "typescript/adjacent-overload-signatures": "warn",
    "typescript/ban-ts-comment": [
      "warn",
      {
        "ts-ignore": true,
        "ts-expect-error": false,
        "ts-nocheck": false,
        "ts-check": false
      }
    ],
    "typescript/ban-types": "warn",
    "typescript/consistent-type-exports": "warn",
    "typescript/consistent-type-imports": "warn",
    "typescript/dot-notation": "warn",
    "typescript/no-duplicate-enum-values": "warn",
    "typescript/no-empty-interface": [
      "error",
      {
        "allowSingleExtends": true
      }
    ],
    "typescript/no-explicit-any": "warn",
    "typescript/no-extra-non-null-assertion": "warn",
    "typescript/no-extraneous-class": [
      "warn",
      {
        "allowConstructorOnly": true,
        "allowEmpty": true
      }
    ],
    "typescript/no-invalid-void-type": "warn",
    "typescript/no-misused-new": "error",
    "typescript/no-non-null-asserted-optional-chain": "error",
    "typescript/no-non-null-assertion": "warn",
    "typescript/no-this-alias": "warn",
    "typescript/no-unnecessary-type-constraint": "warn",
    "typescript/no-unsafe-declaration-merging": "error",
    "typescript/no-useless-empty-export": "warn",
    "typescript/prefer-function-type": "warn",
    "typescript/prefer-literal-enum-member": "warn",
    "typescript/prefer-namespace-keyword": "error",
    "typescript/prefer-optional-chain": "warn",
    "unicorn/new-for-builtins": "error",
    "unicorn/no-document-cookie": "warn",
    "unicorn/no-instanceof-array": "warn",
    "unicorn/no-thenable": "error",
    "unicorn/no-useless-switch-case": "warn",
    "unicorn/prefer-array-flat": "warn",
    "unicorn/prefer-array-flat-map": "warn",
    "unicorn/prefer-array-index-of": "warn",
    "unicorn/prefer-date-now": "warn",
    "unicorn/prefer-node-protocol": "warn",
    "unicorn/prefer-number-properties": [
      "warn",
      {
        "checkInfinity": false,
        "checkNaN": false
      }
    ],
    "location/schema-location": "error",
    "location/error-location": "error"
  },
  "jsPlugins": ["./lint/location-plugin.js"]
}
