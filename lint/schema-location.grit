language js

or {
  JsVariableDeclarator(id=$name, initializer=JsInitializerClause(expression=$value)),
  JsFunctionDeclaration(id=$name, body=$value)
} where {
  $value <: or {
    r"^Schema\.[\s\S]*",
    JsArrowFunctionExpression(body=$body) where {
      $body <: or {
        r"^\(?\s*Schema\.[\s\S]*",
        JsFunctionBody() where {
          $body <: contains JsReturnStatement(argument=r"^Schema\.[\s\S]*")
        }
      }
    },
    JsFunctionBody() where {
      $value <: contains JsReturnStatement(argument=r"^Schema\.[\s\S]*")
    }
  },
  not $filename <: or {
    r"[\s\S]*[-/]schema\.ts$",
    r"[\s\S]*\.test\.ts$"
  },
  register_diagnostic(span=$name, message="Define named Schemas in a sibling *-schema.ts file (e.g. due.ts -> due-schema.ts) and import them. See AGENTS.md.")
}
