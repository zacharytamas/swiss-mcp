language js

pattern schema_expression() {
  and { r"^\(?\s*Schema\.[\s\S]*",
  not r"^\(?\s*Schema\.(?:(?:de|en)code(?:Unknown)?(?:Effect|Exit|Option|Promise|Result|Sync)|is(?:[A-Z]\w*)?|asserts|makeFilter(?:Group)?|makeIs\w*|resolveAnnotations(?:Key)?|to(?:JsonSchemaDocument|Equivalence|Formatter|Iso(?:Focus|Source)?|Representation|DifferJsonPatch|EncoderXml))\b[\s\S]*" }
}

or {
  JsVariableDeclarator(id=$name, initializer=JsInitializerClause(expression=$value)),
  JsFunctionDeclaration(id=$name, body=$value)
} where {
  $value <: or {
    schema_expression(),
    JsArrowFunctionExpression(body=$body) where {
      $body <: or {
        schema_expression(),
        JsFunctionBody() where {
          $body <: contains JsReturnStatement(argument=schema_expression())
        }
      }
    },
    JsFunctionBody() where {
      $value <: contains JsReturnStatement(argument=schema_expression())
    }
  },
  not $filename <: or {
    r"[\s\S]*-schema\.ts$",
    r"[\s\S]*\.test\.ts$"
  },
  register_diagnostic(span=$name, message="Define named Schemas in a sibling *-schema.ts file (e.g. due.ts -> due-schema.ts) and import them. See AGENTS.md.")
}
