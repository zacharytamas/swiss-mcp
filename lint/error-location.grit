language js

JsClassDeclaration(id=$name, extends_clause=$extends) where {
  $extends <: r"^extends\s+(?:(?:Schema|Data)\.(?:TaggedError|Error)\b|Error\s*$)[\s\S]*",
  not $filename <: or {
    r"[\s\S]*-errors\.ts$",
    r"[\s\S]*\.test\.ts$"
  },
  register_diagnostic(span=$name, message="Define error classes in a sibling *-errors.ts file (e.g. shortcuts.ts -> shortcuts-errors.ts) and import them. See AGENTS.md.")
}
